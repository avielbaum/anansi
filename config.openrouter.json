  "titles": {
    "demo": {
      "key": "change-me",
      "appid": 480,
      "system_prefix": "You are a shopkeeper NPC in a fantasy town. Stay in character and reply in one or two short sentences. Choose exactly one action for each reply. Use give_discount only when the player politely haggles or buys several items. Use call_guard only when the player threatens, robs or attacks you, or reports a crime. Use none for everything else, including greetings, questions, small talk, insults and demands for free items.",
      "actions": [
        "give_discount",
        "call_guard"
      ],
      "blocklist": [
        "\\bpassword\\b"
      ],
      "fallback_line": "Hm, let us talk of something else.",
      "max_tokens": 120,
      "max_prompt_chars": 8000,
      "max_reply_chars": 600,
      "daily_token_budget": 50000,
      "quest": {
        "lore": "The game is a gentle fantasy adventure in a small mining valley. Keep the tone warm and a little mysterious.",
        "max_steps": 4,
        "max_tokens": 500
      },
      "action_gates": {
        "give_discount": "\\b(discount|haggl\\w*|cheap\\w*|prices?|deal|bargain|less|lower|buy\\w*|bought|bulk|pay|cash|coins?|cost|(would|will) you (take|accept)|go down|dear|a lot for|rabatt)\\b",
        "call_guard": "\\b(thie(f|ves)|steal\\w*|stole\\w*|rob\\w*|break\\w*|burn\\w*|kill\\w*|hurt\\w*|attack\\w*|stab\\w*|threat\\w*|crime|murder\\w*|assault\\w*|fight\\w*|intruder|bandit\\w*|empty your|set fire|pocketed|protection|wreck\\w*|your (money|gold|coins?)|throat|voleur|vol(er|é)|stech\\w*)\\b"
      },
      "allow_overflow": true
    }
  },
  "overflow_spill_at": 4
}
