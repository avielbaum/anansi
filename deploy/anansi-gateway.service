# Install: copy the repo to /opt/anansi, create /etc/anansi/{config.json,env}, then
#   sudo cp deploy/anansi-gateway.service /etc/systemd/system/ && sudo systemctl enable --now anansi-gateway
# /etc/anansi/env holds ANANSI_ADMIN_TOKEN=... and, if your player-token verifier needs one, its secret (auth.secret_env) (chmod 600). Put TLS in front (Caddy/nginx)
# and list its address in trusted_proxies. The filesystem is read-only to the service except /var/lib/anansi, so set
# "db_path": "/var/lib/anansi/anansi.db" in config.json.
[Unit]
Description=Anansi gateway
After=network-online.target

[Service]
User=anansi
WorkingDirectory=/opt/anansi
Environment=ANANSI_CONFIG=/etc/anansi/config.json
Environment=ANANSI_ENV=production
EnvironmentFile=/etc/anansi/env
ExecStart=/opt/anansi/.venv/bin/python -m uvicorn gateway.app:make_app --factory --host 127.0.0.1 --port 8080
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
StateDirectory=anansi
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
